# Copia este archivo a .env y rellena los valores reales antes de levantar
# `docker compose up`. Los valores de aquí son solo placeholders.

# --- Rails ---
RAILS_ENV=production
SECRET_KEY_BASE= # genera uno con: bin/rails secret

# --- Base de datos (docker-compose ya fija DATABASE_HOST=db) ---
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Active Record Encryption (Repository#webhook_secret cifrado en reposo) ---
# Genera las 3 claves con: bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Integraciones externas ---
SLACK_BOT_TOKEN=
