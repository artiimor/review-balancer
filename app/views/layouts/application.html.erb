<!DOCTYPE html>
<html>
  <head>
    <title>ReviewBalancer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50">
    <% if notice %>
      <p class="mx-auto mt-4 max-w-md rounded-lg bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="mx-auto mt-4 max-w-md rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= alert %></p>
    <% end %>

    <main class="flex min-h-screen items-center justify-center p-6">
      <div class="relative w-full max-w-6xl">
        <div class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] bg-[length:22px_22px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,black,transparent)] opacity-60"></div>

        <div class="pointer-events-none absolute -left-32 top-0 -z-10 hidden h-80 w-80 rounded-full bg-indigo-200/50 blur-3xl lg:block"></div>
        <div class="pointer-events-none absolute -right-32 bottom-0 -z-10 hidden h-80 w-80 rounded-full bg-violet-200/50 blur-3xl lg:block"></div>
        <div class="pointer-events-none absolute right-1/3 top-0 -z-10 hidden h-56 w-56 rounded-full bg-emerald-200/30 blur-3xl lg:block"></div>

        <div class="pointer-events-none absolute -left-6 top-28 hidden w-48 -rotate-6 rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-900/5 lg:block">
          <div class="flex items-center justify-between">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-600">MR</div>
            <svg class="h-4 w-10 text-slate-300" viewBox="0 0 40 16" fill="none">
              <path d="M2 8c8-10 28 10 36 0" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round"/>
            </svg>
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 text-xs font-semibold text-emerald-600">LD</div>
          </div>
          <p class="mt-3 text-xs font-medium text-slate-500">Revisión asignada</p>
          <p class="text-xs text-slate-400">hace 2 min</p>
        </div>

        <div class="pointer-events-none absolute -right-8 bottom-20 hidden w-44 rotate-6 rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-900/5 lg:block">
          <p class="text-xs font-medium text-slate-500">Revisiones repartidas</p>
          <div class="mt-3 flex h-12 items-end gap-1.5">
            <div class="w-3 rounded-t bg-indigo-200" style="height:40%"></div>
            <div class="w-3 rounded-t bg-indigo-300" style="height:65%"></div>
            <div class="w-3 rounded-t bg-indigo-500" style="height:90%"></div>
            <div class="w-3 rounded-t bg-indigo-300" style="height:55%"></div>
            <div class="w-3 rounded-t bg-indigo-200" style="height:35%"></div>
          </div>
          <p class="mt-2 text-xs font-semibold text-indigo-600">+18% esta semana</p>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
