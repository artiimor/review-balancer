<div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-white/10">
  <div class="border-b border-slate-100 px-6 py-5 dark:border-slate-700">
    <h2 class="text-base font-semibold text-slate-900 dark:text-white">GitLab</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('views.configuration.gitlab_token.description') %></p>
  </div>

  <div class="px-6 py-6">
    <% if @configuration.gitlab_access_token.present? %>
      <div class="flex items-start justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3.5 dark:border-slate-700 dark:bg-slate-900">
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 1a4 4 0 0 0-4 4v2H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-1V5a4 4 0 0 0-4-4Zm2 6V5a2 2 0 1 0-4 0v2h4Z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= t('views.configuration.gitlab_token.configured_label') %></p>
            <p class="mt-0.5 text-xs text-slate-400 dark:text-slate-500"><%= t('views.configuration.gitlab_token.configured_hint') %></p>
            <p class="mt-1 text-xs text-slate-400 dark:text-slate-500"><%= t('views.configuration.gitlab_token.instance_label') %>: <%= @configuration.gitlab_url.presence || Configuration::DEFAULT_GITLAB_URL %></p>
          </div>
        </div>

        <%= button_to t('views.configuration.gitlab_token.delete_button'), destroy_gitlab_token_path, method: :delete,
              form: { class: "shrink-0" },
              data: { turbo_confirm: t('views.configuration.gitlab_token.delete_confirm') },
              class: "cursor-pointer rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50 dark:border-red-900/50 dark:bg-slate-800 dark:text-red-400 dark:hover:bg-red-950" %>
      </div>
    <% else %>
      <%= form_for @configuration, url: configuration_path, method: :patch, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :gitlab_url, t('views.configuration.gitlab_token.url_label'), class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= f.text_field :gitlab_url, autocomplete: "off", placeholder: t('views.configuration.gitlab_token.url_placeholder'),
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" %>
          <p class="mt-1 text-xs text-slate-400 dark:text-slate-500"><%= t('views.configuration.gitlab_token.url_hint_html') %></p>
        </div>

        <div>
          <%= f.label :gitlab_access_token, t('views.configuration.gitlab_token.token_label'), class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= f.password_field :gitlab_access_token, autocomplete: "off", placeholder: t('views.configuration.gitlab_token.token_placeholder'),
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" %>
          <p class="mt-1 text-xs text-slate-400 dark:text-slate-500"><%= t('views.configuration.gitlab_token.token_hint_html') %></p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <%= f.submit t('views.configuration.gitlab_token.submit'),
                class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-400" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
