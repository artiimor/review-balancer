<div class="mx-auto max-w-3xl">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-lg font-bold text-white shadow-md shadow-indigo-600/20">
        RB
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-lg font-semibold tracking-tight text-slate-900">ReviewBalancer</h1>
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            </span>
            <%= t('views.repositories.index.badge') %>
          </span>
        </div>
        <p class="text-sm text-slate-500"><%= current_user.email %></p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to t('views.repositories.index.settings'), configuration_path,
            class: "inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
      <%= button_to t('views.repositories.index.sign_out'), destroy_user_session_path, method: :delete,
            class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
      <h2 class="text-base font-semibold text-slate-900"><%= t('views.repositories.index.heading') %></h2>

      <%= link_to new_repository_path, data: { turbo_frame: "repository-modal" },
            class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" do %>
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" />
        </svg>
        <%= t('views.repositories.index.new_repository') %>
      <% end %>
    </div>

    <div id="main-content">
      <div id="general_error">
        <%= render partial: 'repositories/error_message', locals: { message: nil } %>
      </div>
      <%= render partial: 'repositories/table', locals: { repositories: @repositories } %>
    </div>

    <%= turbo_frame_tag "repository-modal" %>
  </div>
</div>
