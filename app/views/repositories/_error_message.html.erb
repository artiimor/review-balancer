<% if message %>
  <div data-controller="error-message" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative dark:bg-red-950 dark:border-red-900 dark:text-red-300" role="alert">
    <strong class="font-bold"><%= t('views.repositories.error_message.title') %></strong>
    <span class="block sm:inline"><%= message %></span>
  </div>
<% end %>