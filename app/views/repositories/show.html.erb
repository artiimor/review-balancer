<div class="mx-auto max-w-3xl">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to repositories_path,
            class: "rounded-lg p-2 text-slate-400 transition hover:bg-white hover:text-slate-600",
            "aria-label": t('views.repositories.show.back_aria') do %>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 0-1.414l4-4a1 1 0 1 1 1.414 1.414L7.414 9H16a1 1 0 1 1 0 2H7.414l2.293 2.293a1 1 0 0 1 0 1.414Z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <div>
        <h1 class="text-lg font-semibold tracking-tight text-slate-900"><%= @repository.github_full_name %></h1>
        <p class="text-sm text-slate-500"><%= t('views.repositories.show.pull_request_count', count: @pull_requests.size) %></p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to t('views.repositories.show.contributors_link'), repository_contributors_path(@repository),
            class: "inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

      <%= button_to t('views.repositories.show.sign_out'), destroy_user_session_path, method: :delete,
            class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>
  </div>

  <%= render partial: 'repositories/dashboard', locals: { dashboard: @dashboard } %>

  <div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5">
    <div class="border-b border-slate-100 px-6 py-5">
      <h2 class="text-base font-semibold text-slate-900"><%= t('views.repositories.show.pull_requests_heading') %></h2>
    </div>

    <% if @pull_requests.any? %>
      <%= render partial: 'repositories/pull_requests', locals: { pull_requests: @pull_requests, repository: @repository, per_page: @per_page } %>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500"><%= t('views.repositories.show.empty') %></p>
    <% end %>
  </div>
</div>
