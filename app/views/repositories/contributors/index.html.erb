<div class="mx-auto max-w-5xl">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to repository_path(@repository),
            class: "rounded-lg p-2 text-slate-400 transition hover:bg-white hover:text-slate-600 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-300",
            "aria-label": t('views.repositories.contributors.index.back_aria') do %>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 0-1.414l4-4a1 1 0 1 1 1.414 1.414L7.414 9H16a1 1 0 1 1 0 2H7.414l2.293 2.293a1 1 0 0 1 0 1.414Z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <div>
        <h1 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white"><%= @repository.github_full_name %></h1>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= t('views.repositories.contributors.index.contributor_count', count: @contributors.size) %></p>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-white/10">
    <div class="border-b border-slate-100 px-6 py-5 dark:border-slate-700">
      <h2 class="text-base font-semibold text-slate-900 dark:text-white"><%= t('views.repositories.contributors.index.heading') %></h2>
    </div>

    <% if @contributors.any? %>
      <%= render partial: 'repositories/contributors/table', locals: { contributors: @contributors } %>
    <% else %>
      <p class="px-6 py-10 text-center text-sm text-slate-500 dark:text-slate-400"><%= t('views.repositories.contributors.index.empty') %></p>
    <% end %>
  </div>
</div>
