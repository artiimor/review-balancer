<tr id="<%= dom_id(contributor) %>" class="hover:bg-slate-50">
  <td class="whitespace-nowrap px-6 py-4 font-medium text-slate-900"><%= contributor.github_login %></td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-600"><%= contributor.name %></td>
  <td class="whitespace-nowrap px-6 py-4">
    <% if contributor.active %>
      <svg class="h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" role="img">
        <title><%= t('views.repositories.contributors.contributor_row.active_true') %></title>
        <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.415l-7.5 7.6a1 1 0 0 1-1.421 0l-3.5-3.55a1 1 0 1 1 1.422-1.406l2.79 2.828 6.79-6.881a1 1 0 0 1 1.413-.006Z" clip-rule="evenodd" />
      </svg>
    <% else %>
      <svg class="h-5 w-5 text-rose-500" viewBox="0 0 20 20" fill="currentColor" role="img">
        <title><%= t('views.repositories.contributors.contributor_row.active_false') %></title>
        <path fill-rule="evenodd" d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L8.94 10l-4.72 4.72a.75.75 0 1 0 1.06 1.06L10 11.06l4.72 4.72a.75.75 0 1 0 1.06-1.06L11.06 10l4.72-4.72a.75.75 0 0 0-1.06-1.06L10 8.94 5.28 4.22Z" clip-rule="evenodd" />
      </svg>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-600"><%= contributor.current_review_load %></td>
  <td class="px-6 py-4 text-slate-600">
    <span class="text-slate-400"><%= contributor.created_at %></span>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-500">
    <div class="flex items-center gap-1">
      <%= button_to repository_contributor_path(@repository, contributor),
            method: :patch,
            params: { contributor: { active: !contributor.active } },
            form: { class: 'contents' },
            class: 'rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-indigo-600',
            aria: { label: t('views.repositories.contributors.contributor_row.toggle_active_aria') } do %>
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 2a1 1 0 0 1 1 1v6a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Z" />
          <path fill-rule="evenodd" d="M5.05 5.05a1 1 0 0 1 1.414 1.415 5 5 0 1 0 7.07 0 1 1 0 0 1 1.415-1.415 7 7 0 1 1-9.9 0Z" clip-rule="evenodd" />
        </svg>
      <% end %>

      <%= link_to repository_contributor_holidays_path(@repository, contributor),
            class: 'rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-indigo-600',
            data: { turbo_frame: '_top' },
            aria: { label: t('views.repositories.contributors.contributor_row.holidays_aria') } do %>
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M6 2a1 1 0 0 1 1 1v1h6V3a1 1 0 1 1 2 0v1h.5A2.5 2.5 0 0 1 18 6.5v9A2.5 2.5 0 0 1 15.5 18h-11A2.5 2.5 0 0 1 2 15.5v-9A2.5 2.5 0 0 1 4.5 4H5V3a1 1 0 0 1 1-1Zm-2 6.5v7c0 .276.224.5.5.5h11a.5.5 0 0 0 .5-.5v-7H4Z" />
        </svg>
      <% end %>
    </div>
  </td>
</tr>
