<% assignment = pull_request.current_review_assignment %>
<tr id="<%= dom_id(pull_request) %>" class="hover:bg-slate-50 dark:hover:bg-slate-700/50">
  <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
    <span class="text-slate-400 dark:text-slate-500">#<%= pull_request.github_number %></span> <%= pull_request.title %>
  </td>
  <td class="whitespace-nowrap px-6 py-4">
    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= pull_request_state_badge_classes(pull_request.state) %>"><%= t("views.repositories.pull_request.states.#{pull_request.state}", default: pull_request.state) %></span>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-600 dark:text-slate-400">
    <% if pull_request.state == 'open' %>
      <%= link_to assignment&.reviewer&.github_login || t('views.repositories.pull_request.unassigned'),
            new_repository_pull_request_review_assignment_path(pull_request.repository, pull_request),
            data: { turbo_frame: "review-assignment-modal" },
            class: "rounded text-indigo-600 hover:underline dark:text-indigo-400" %>
    <% else %>
      <%= assignment&.reviewer&.github_login || t('views.repositories.pull_request.unassigned') %>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-500 dark:text-slate-400">
    <%= assignment&.matched_tech || (assignment&.source == 'manual' ? t('views.repositories.pull_request.manually_assigned') : (assignment ? t('views.repositories.pull_request.availability') : "—")) %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-slate-500 dark:text-slate-400">
    <% if assignment %>
      <%= distance_of_time_in_words(assignment.assigned_at, assignment.review_duration_end) %><%= t('views.repositories.pull_request.in_progress_suffix') unless assignment.completed_at %>
    <% else %>
      —
    <% end %>
  </td>
</tr>
