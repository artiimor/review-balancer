<p><%= t('views.devise.mailer.email_changed.hello', email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t('views.devise.mailer.email_changed.unconfirmed_notice', email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t('views.devise.mailer.email_changed.changed_notice', email: @resource.email) %></p>
<% end %>
