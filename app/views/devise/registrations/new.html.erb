<div class="w-full max-w-md rounded-2xl bg-white p-10 shadow-xl ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-white/10">
  <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-2xl font-bold text-white dark:bg-indigo-500">
    RB
  </div>

  <h2 class="text-center text-2xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= t('views.devise.registrations.new.heading') %></h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <% if @minimum_password_length %>
        <p class="mt-0.5 text-xs text-slate-400 dark:text-slate-500"><%= t('views.devise.registrations.new.password_minimum', count: @minimum_password_length) %></p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password",
            class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" %>
    </div>

    <div>
      <%= f.submit t('views.devise.registrations.new.submit'),
            class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-400" %>
    </div>
  <% end %>

  <div class="mt-6 space-y-1.5 text-center text-sm text-slate-500 dark:text-slate-400 [&_a]:font-medium [&_a]:text-indigo-600 [&_a]:hover:text-indigo-500 dark:[&_a]:text-indigo-400 dark:[&_a]:hover:text-indigo-300">
    <%= render "devise/shared/links" %>
  </div>
</div>
