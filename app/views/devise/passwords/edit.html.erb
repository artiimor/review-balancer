<h2><%= t('views.devise.passwords.edit.heading') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, t('views.devise.passwords.edit.new_password_label') %></p>
    <% if @minimum_password_length %>
      <p><em><%= t('views.devise.passwords.edit.minimum_characters', count: @minimum_password_length) %></em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, t('views.devise.passwords.edit.confirm_password_label') %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit t('views.devise.passwords.edit.submit') %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
