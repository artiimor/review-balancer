<div class="w-full max-w-md rounded-2xl bg-white p-10 shadow-xl ring-1 ring-slate-900/5">
  <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-2xl font-bold text-white">
    RB
  </div>

  <h2 class="text-center text-2xl font-semibold tracking-tight text-slate-900"><%= t('views.devise.passwords.new.heading') %></h2>
  <p class="mt-1 text-center text-sm text-slate-500"><%= t('views.devise.passwords.new.subtitle') %></p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30" %>
    </div>

    <div>
      <%= f.submit t('views.devise.passwords.new.submit'),
            class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
    </div>
  <% end %>

  <div class="mt-6 space-y-1.5 text-center text-sm text-slate-500 [&_a]:font-medium [&_a]:text-indigo-600 [&_a]:hover:text-indigo-500">
    <%= render "devise/shared/links" %>
  </div>
</div>
